{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/og/:shareCode",
      "destination": "/api/og?shareCode=:shareCode"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
