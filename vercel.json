{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "devCommand": "vite",
  "cleanUrls": false,
  "trailingSlash": false,
  "regions": ["bom1"],
  "functions": {
    "api/media.js": { "memory": 1024, "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' https://*.supabase.co https://*.r2.dev https://img.mydenner.com data: blob:; media-src 'self' https://*.supabase.co https://*.r2.dev https://img.mydenner.com blob:; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/og/:shareCode",
      "destination": "/api/og?shareCode=:shareCode"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
