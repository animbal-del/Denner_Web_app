VITE_PUBLIC_APP_BASE_URL=https://yourdomain.com
VITE_OPS_APP_BASE_URL=https://ops.yourdomain.com
VITE_USE_MOCK=false

# Supabase project — get these from your project's Settings → API
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<ANON_KEY>

NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY>
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3001

# Server-only — add to Vercel env vars, NEVER commit the real value
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# Storage bucket name
VITE_SUPABASE_STORAGE_BUCKET=property-photos
